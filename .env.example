# Supabase — the same project WP Manager and Site in a Day use (same database,
# same logins). Copy these three from wp-manager/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Only this email (plus the team added in WP Manager → Settings) may sign in.
ALLOWED_EMAIL=

# Claude API key: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Any long random string. Lets a prompt run hand itself off to a fresh
# function between steps. Generate one with:  openssl rand -base64 32
CRON_SECRET=

# Public URL of this app (no trailing slash). Defaults to the request origin.
NEXT_PUBLIC_APP_URL=

# Development only: skip the Claude API and wait for hand-written replies in
# this folder (see src/lib/runs/stand-in.ts). Ignored in production.
# CLAUDE_STAND_IN_DIR=.stand-in

# Encrypts stored Google refresh tokens. Use the SAME value as WP Manager's
# CREDENTIALS_KEY (same database).  openssl rand -base64 32
CREDENTIALS_KEY=

# Google Search Console connection (optional). Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <app URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
